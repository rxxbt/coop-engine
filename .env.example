RPC_URL=https://api.mainnet-beta.solana.com
# Helius (recommended): enables DAS getTokenAccounts for holder snapshots
HELIUS_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# operator keypair (transfer-fee authority + signer). Only needed with --execute; lives on the server only.
OPERATOR_KEYPAIR=./keys/operator.json
# after graduation: the wallet that receives the platform's share of the pools' creator fees (unset: it stays with the operator),
# and the floor below which a pool's fees are left to accrue instead of being claimed (dollars, default 1)
PLATFORM_FEE_WALLET=
MIN_FORWARD_USD=1
# Jupiter: keyless access is capped at 0.5 requests per second. A key from https://developers.jup.ag/portal (the free plan allows 1 a second)
# moves every call to api.jup.ag; scripts/jupiter-key-setup.sh installs it on the server. JUP_RPS overrides the pace (paid plans allow more).
JUP_API_KEY=
JUP_RPS=
