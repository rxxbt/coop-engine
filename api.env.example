# COOP engine API (src/api.ts). Load together with .env (RPC_URL, HELIUS_RPC, OPERATOR_KEYPAIR).
API_HOST=127.0.0.1
API_PORT=8787
PUBLIC_BASE=https://api.coopfam.xyz        # what uploaded metadata/image URLs start with
SITE_BASE=https://coopfam.xyz              # token page links returned to the form
CORS_ORIGINS=https://coopfam.xyz,http://127.0.0.1:5173,http://localhost:5173
STORE_DIR=store                          # local metadata/image store (used when PINATA_JWT is unset)
# PINATA_JWT=...                         # optional: pin metadata + image to IPFS instead of serving them locally
# IPFS_GATEWAY=https://gateway.pinata.cloud
# OPERATOR_PUBKEY=9dZcuWdTRjStMFNpQGDsSUZvTBkhrGZXxFvNMkjbpYKv   # derived from OPERATOR_KEYPAIR when unset
